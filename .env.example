# Copy this file to .env and fill in your values. Never upload .env to GitHub.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
DB_POOL_MAX=5

# Local only: path to the Google service account key file
GOOGLE_SERVICE_ACCOUNT_KEY=./secrets/dceb-service-account.json

# Google Drive folder ID of the "DCEB Receipts" folder in your Shared Drive
DRIVE_RECEIPTS_FOLDER_ID=paste_folder_id_here
